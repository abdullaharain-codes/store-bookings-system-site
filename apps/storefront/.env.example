# Optional storefront branding overrides. Every value falls back to a safe
# default, so the app runs with no .env at all. None of these are secrets.
# Copy to `.env` (git-ignored) to override locally.

# Wordmark in the header and footer. Default: TechFix
VITE_SITE_NAME=

# One-line positioning under the footer wordmark.
VITE_SITE_TAGLINE=

# Promotional strip above the header. Leave empty to hide the strip entirely.
VITE_SITE_ANNOUNCEMENT=

# Footer contact block. Each is rendered only when set; leave empty to omit.
VITE_SITE_SUPPORT_EMAIL=
VITE_SITE_SUPPORT_PHONE=
VITE_SITE_ADDRESS=

# Build-stable copyright year. A literal is used on purpose so the prerendered
# HTML and the hydrated client can never disagree.
VITE_SITE_COPYRIGHT_YEAR=
